<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: asked for once, after the device is connected. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only for the pairing code on the site's /app page. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".RoamlightApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Roamlight"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false">

        <!--
          ⚠ allowBackup="false" is not laziness. The device token stays valid
            until somebody revokes it on the site. Google's cloud backup would
            carry it to a new phone, and the site's device list would then be
            wrong about which machine holds it. Here you pair again — which is
            exactly what the iOS app does with ThisDeviceOnly.

          ⚠ usesCleartextTraffic: a family server on the home network often has
            no certificate, and refusing http:// outright would make the app
            useless for the people it is written for. The platform therefore
            permits it — and Api.requireSafeAddress() then refuses to pair over
            plain http with anything that is NOT a private address. Public host,
            no certificate, no pairing.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Roamlight">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              The way back from single sign-on: the site's /app/sso page sends
              the browser to roamlight://sso?c=<code>.
              ⚠ Any app can claim a scheme on Android. That is why the code is
                bound to a secret only THIS app holds (see AppState.startSso):
                an app that catches the address has a code it cannot redeem.
              ⚠ singleTask: the browser hands the address back to the Roamlight
                that is already running, instead of stacking a second one on top.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="roamlight" android:host="sso" />
            </intent-filter>
        </activity>
        <!-- The notices. Not exported: only Firebase inside this app talks to it. -->
        <service
            android:name=".RoamlightMessaging"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="albums" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <!-- ⚠ No analytics collection, even by accident. -->
        <meta-data android:name="firebase_analytics_collection_deactivated" android:value="true" />
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
    </application>
</manifest>
