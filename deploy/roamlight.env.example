# Roamlight — configuration. Every setting is an environment variable;
# these are the ones you are likely to touch. The rest, with the reason each
# one exists, is in app/config.py.

# --- who may in --------------------------------------------------------------
# local | oidc | local+oidc -- the last is the usual one: everybody through the
# provider, and one password account for the day the provider is down.
#
#   local   accounts on this site, with a password.
#   oidc    the site is an OpenID Connect client ITSELF and talks to your
#           provider (Authentik, Keycloak, Entra…). No outpost, no shared
#           secret, nothing in the proxy's configuration.
#
# ⚠ `proxy` (an identity proxy in front setting headers) was taken out on
#   08.09.2026. `oidc` does the same job inside the program.
# ⚠ The settings page can switch `oidc` on and off, but can never take `local`
#   away -- that road is what you still have when the provider is wrong.
#   FAMILY_AUTH_LOCK=1 turns the page's switch off entirely.
FAMILY_AUTH=local
# ⚠ Leave this at 1. It is what makes the site refuse a request that carries
#   no identity at all.
FAMILY_REQUIRE_AUTH=1
# ⚠ Left over from the proxy road, which is gone (08.09.2026). Nothing reads
#   the first one any more, and the sign-in button goes to this site's own
#   /auth/oidc/login. They are listed so that an old file does not look as
#   though it has settings the site has forgotten about.
#FAMILY_PROXY_SECRET_FILE=/etc/roamlight/proxy-secret
#FAMILY_SSO_START=/outpost.goauthentik.io/start
#FAMILY_SSO_LOGOUT=/outpost.goauthentik.io/sign_out

# --- the provider, for FAMILY_AUTH=…oidc -------------------------------------
# ⚠ All of these are DEFAULTS. What the settings page stores wins over them, so
#   an installation can be configured from this file, or from the page, or
#   from this file and then adjusted on the page -- without either having to
#   know about the other.
# ⚠ The issuer decides which addresses this site fetches and whose signatures
#   it trusts, so it is read from here and NEVER from a request. https, and no
#   query string (http is allowed only for localhost, for testing).
#FAMILY_OIDC_ISSUER=https://auth.example.com/application/o/roamlight/
#FAMILY_OIDC_CLIENT_ID=
# The client secret, in a file of its own. Leave it out for a public client --
# PKCE is used either way and is what protects the exchange.
#FAMILY_OIDC_SECRET_FILE=/etc/roamlight/oidc-secret
# Where the provider sends the browser back. Built from FAMILY_SITE_URL when
# this is empty; register the same address with the provider.
#FAMILY_OIDC_REDIRECT_URI=https://photos.example.com/auth/oidc/callback
#FAMILY_OIDC_SCOPES=openid email profile
# ⚠ The name is taken EXACTLY as the provider spells it and is never
#   lower-cased: the album permissions are rows that say `user:Guy`, in the
#   directory's spelling. Lowering it makes a second person with no albums.
#FAMILY_OIDC_USERNAME_CLAIM=preferred_username
# The groups from the token are matched by NAME against FAMILY_ADMIN_GROUPS
# and friends, so the site learns no second vocabulary.
#FAMILY_OIDC_GROUPS_CLAIM=groups
# Only for a provider with no discovery document. An exception, not the road.
#FAMILY_OIDC_AUTHORIZATION_URL=
#FAMILY_OIDC_TOKEN_URL=
#FAMILY_OIDC_JWKS_URL=
#FAMILY_OIDC_END_SESSION_URL=

# --- what it is called -------------------------------------------------------
FAMILY_SITE_TITLE=Roamlight
# ⚠ Share links are built from this. "localhost" makes a link nobody else can
#   open.
FAMILY_SITE_URL=http://localhost:8080

# --- where the photographs are ----------------------------------------------
# Read, never written into (except by an upload).
FAMILY_ORIGINS=/originals
# Written: one master JPEG per photograph, same folder structure.
FAMILY_WEB=/library
# Database, derivatives, uploads in progress.
FAMILY_DATA=/data
FAMILY_DB=/data/roamlight.db
FAMILY_DERIVATIVES=/data/derivatives
FAMILY_INCOMING=/data/incoming
# ⚠ 1 = refuse to start when those folders are not mounted. An unmounted share
#   looks like an empty folder, and an empty folder looks like "every
#   photograph is gone".
FAMILY_REQUIRE_MOUNT=1

# --- roles -------------------------------------------------------------------
# Group names. With local accounts these are just labels on the account; with
# a proxy they are the groups it passes.
# ⚠ The first start is an open door: until an account exists, whoever
#   reaches the address can make themselves the administrator. On a
#   network with other people on it, set a word here -- /setup then only
#   answers to ?t=<that word>. Remove it once the account is made.
#FAMILY_SETUP_TOKEN=

FAMILY_ADMIN_GROUPS=admin
FAMILY_VIEWER_GROUPS=family
FAMILY_CONTRIBUTOR_GROUPS=family

# --- optional ----------------------------------------------------------------
FAMILY_SHARES=1
# Virus scanning. 0 = off (default). With a neighbouring container, also set
# FAMILY_CLAMAV_HOST.
FAMILY_CLAMAV=0
#FAMILY_CLAMAV_HOST=clamav
# Conversions at the same time; one takes about ¾ of a core.
FAMILY_WORKERS=2
# The map starts here when an album has no coordinates.
FAMILY_HOME_NAME=Luxembourg
FAMILY_HOME_LAT=49.6117
FAMILY_HOME_LON=6.1319
