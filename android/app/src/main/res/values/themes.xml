<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The window before Compose paints. Same ground as the site (#1a1815),
         so the app does not flash white on a cold start. -->
    <style name="Theme.Roamlight" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:navigationBarColor">@color/ground</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
